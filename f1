#include<stdlib.h>
#include<stdio.h>
#include<string.h>
#include<stdbool.h>

int main()
{
    while (1)
    {
        char enemy1[257];
        int dist1;

        char enemy2[257];
        int dist2;

        scanf("%s", enemy1);
        scanf("%d", &dist1);

        scanf("%s", enemy2);
        scanf("%d", &dist2);

        if(dist1 < dist2)
        {
            printf("%s\n", enemy1);
        }
        else
        {
            printf("%s\n", enemy2);
        }
    }

    return 0;
}
